msgctxt "help.jobs.title"
msgid "How do jobs work?"
msgstr ""

#. The meaning of the word before it, as a short sentence.
msgctxt "help.jobs.word1.means"
msgid "What a shift pays before tax."
msgstr ""

#. A word this page explains, shown in bold above its meaning.
msgctxt "help.jobs.word1.term"
msgid "Wage"
msgstr ""

#. The meaning of the word before it, as a short sentence.
msgctxt "help.jobs.word2.means"
