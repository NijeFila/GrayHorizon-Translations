msgid "Putting your name forward in an election. The time to run comes first, then the vote."
msgstr ""

#. Putting your name forward in an election. Not jogging.
msgctxt "glossary.running.name"
msgid "Running"
msgstr ""

msgctxt "glossary.scrap.meaning"
msgid "What gear is mended with. Cases give it, and so does breaking up broken gear."
msgstr ""

msgctxt "glossary.scrap.name"
msgid "Scrap"
msgstr ""

msgctxt "glossary.session.meaning"
msgid "A device where you are signed in."
msgstr ""

#. A device where a player is signed in. Not a meeting.
msgctxt "glossary.session.name"
msgid "Session"
msgstr ""

msgctxt "glossary.share.meaning"
msgid "A piece of a company. Every company is a hundred thousand of them; more than half is control of it."
msgstr ""

#. A noun: a part of a company's ownership. Not the verb.
msgctxt "glossary.share.name"
msgid "Share"
msgstr ""

#. {shortEnergy}, {fullEnergy}, {xp} and {multiplier} are numbers.
msgctxt "glossary.shift.meaning"
msgid "One day's work, at a job or on a worksite. A short shift is {shortEnergy} Energy for the wage and {xp} XP; a full shift is {fullEnergy} Energy for {multiplier} times the wage and the same XP."
msgstr ""

#. A noun: one day's work. Not a change.
msgctxt "glossary.shift.name"
msgid "Shift"
msgstr ""

msgctxt "glossary.site.meaning"
msgid "A place where a company or a country works."
msgstr ""

#. A noun: a place where a company or a country works, such as a factory or a mine. Not a website.
msgctxt "glossary.site.name"
msgid "Site"
msgstr ""

msgctxt "glossary.stateCompany.meaning"
msgid "A company a country owns. An office of the country runs it, and once a week what it holds beyond two weeks of wages goes to its owners."
msgstr ""

msgctxt "glossary.stateCompany.name"
msgid "State company"
msgstr ""

msgctxt "glossary.streak.meaning"
msgid "How many days in a row you finished today's goals."
msgstr ""

#. A noun: days in a row.
msgctxt "glossary.streak.name"
