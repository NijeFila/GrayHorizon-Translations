msgstr ""

msgctxt "econ.ledger.politicalPartyDonation"
msgid "A donation to a party"
msgstr ""

msgctxt "econ.ledger.privateBankFounded"
msgid "Founding a bank"
msgstr ""

msgctxt "econ.ledger.stateAid"
msgid "State aid"
msgstr ""

msgctxt "econ.ledger.stateAidTransfer"
msgid "State aid, paid"
msgstr ""

#. Said under a line of the reader's money record: who the money went to. {party} is a name, drawn as a link; "the" is added before a country's name in English.
msgctxt "econ.ledger.to"
msgid "to {party}"
msgstr ""

#. Said under a line of the reader's money record: who the money went to and what it was for. {party} is a name; {title} is the title of an article in quotation marks, drawn as a link.
msgctxt "econ.ledger.toAbout"
msgid "to {party} for {title}"
msgstr ""

msgctxt "econ.ledger.treasuryGrant"
msgid "A grant out of the Treasury"
msgstr ""

#. Said under a line of the reader's money record: who the other side of the deal was. {party} is a name, drawn as a link.
msgctxt "econ.ledger.with"
msgid "with {party}"
msgstr ""

#. Said under a line of the reader's money record: who the other side was and what it was for. {party} is a name; {title} is the title of an article in quotation marks, drawn as a link.
msgctxt "econ.ledger.withAbout"
msgid "with {party} for {title}"
msgstr ""

#. The end of a list of things. {rest} is the earlier items already joined with commas; {last} is the final item. Example: "1 000.00 CR and 100 industrial components".
msgctxt "econ.list.and"
msgid "{rest} and {last}"
msgstr ""

msgctxt "econ.loanPurpose.facilityConstruction"
msgid "to build a place to work"
msgstr ""

msgctxt "econ.loanPurpose.facilityUpgrade"
msgid "to raise a place of work a level"
msgstr ""

#. What a loan is for, said after the amount. The borrower named no purpose.
msgctxt "econ.loanPurpose.general"
msgid "no stated purpose"
msgstr ""

#. What a loan is for. Stock means goods a company holds to use or sell.
msgctxt "econ.loanPurpose.inventory"
msgid "to buy stock"
msgstr ""

msgctxt "econ.loanPurpose.recovery"
msgid "to keep the company going"
msgstr ""

msgctxt "econ.loanPurpose.research"
msgid "to pay for research"
msgstr ""

msgctxt "econ.loanStatus.active"
msgid "Being repaid"
msgstr ""

msgctxt "econ.loanStatus.cancelled"
msgid "Withdrawn"
msgstr ""

#. Where a loan stands. The borrower stopped paying and did not catch up.
msgctxt "econ.loanStatus.defaulted"
msgid "Defaulted"
msgstr ""

#. Where a loan stands. The bank has offered it and the borrower has not taken it yet.
msgctxt "econ.loanStatus.offered"
msgid "Waiting for you"
msgstr ""

msgctxt "econ.loanStatus.repaid"
msgid "Repaid in full"
msgstr ""

#. Said beside a control that is locked for a new account. {act} is a whole clause written by the screen, for example "You can tip writers"; {wait} is a length of time such as "48 hours".
msgctxt "econ.lock.sentence"
msgid "{act} in {wait}, when your account is no longer new."
msgstr ""

#. About machines that did not work today. {hour} is a clock time such as 14:30 on the world clock (UTC).
msgctxt "econ.machine.againAt"
msgid "Next try {hour} world time, or when goods arrive."
msgstr ""

#. About machines that did not work today.
msgctxt "econ.machine.againLater"
msgid "Next try when goods arrive, or tomorrow."
msgstr ""

#. About machines that did not work today: they have used up their tries.
msgctxt "econ.machine.againNone"
msgid "No tries left today; tomorrow it starts again."
msgstr ""

#. Said under a cross on the fuel line: a machine may be installed before it has any fuel.
msgctxt "econ.machine.beforeFuel"
msgid "It can be automated now and stand idle, at no cost, until fuel arrives."
msgstr ""

#. A tick-or-cross line on what automating needs. {cost} and {have} are amounts of money; the company holds {have}.
msgctxt "econ.machine.checkCredits"
msgid "{cost} to automate ({have} in hand)"
msgstr ""

#. A tick line on what automating needs. {fuel} is a quantity of fuel such as "12 fuel".
msgctxt "econ.machine.checkFuelEnough"
msgid "{fuel} held, enough for a day"
msgstr ""

#. A cross line on what automating needs. {fuel} is a quantity of fuel the company holds; {need} is how many it would burn.
msgctxt "econ.machine.checkFuelShort"
msgid "{fuel} held; a day's work for {lines, plural, one {1 line} other {{lines} lines}} burns {need}"
msgstr ""

#. A tick-or-cross line on what automating needs: how many of the site's places are empty.
msgctxt "econ.machine.checkPlaces"
msgid "{free, plural, one {1 place} other {{free} places}} free of {total}"
msgstr ""

#. The second row of the comparison table: what each costs every day. Keep it short.
msgctxt "econ.machine.cmpCost"
msgid "Costs a day"
msgstr ""

#. A cell in the comparison table, under the automation line: the fuel it burns in a day and roughly what that fuel costs. {burned} is a quantity of fuel such as "3 fuel"; {cost} is an amount of money.
msgctxt "econ.machine.cmpCostMachine"
msgid "{burned}, about {cost}"
msgstr ""

#. The third row of the comparison table: what the owner must do for each. It completes a sentence such as "Needs you to hire them". Keep it short.
msgctxt "econ.machine.cmpNeeds"
msgid "Needs you to"
msgstr ""

#. A cell in the comparison table, under the automation line, after "Needs you to".
msgctxt "econ.machine.cmpNeedsMachine"
msgid "keep {goods} in stock"
msgstr ""

#. A cell in the comparison table, under the person, after "Needs you to".
msgctxt "econ.machine.cmpNeedsPerson"
msgid "hire them"
msgstr ""

#. The last row of the comparison table: what each costs one time, at the start. Keep it short.
msgctxt "econ.machine.cmpOnce"
msgid "Once"
msgstr ""

#. A cell in the comparison table, under the automation line: the one-time price. {cost} is an amount of money.
msgctxt "econ.machine.cmpOnceMachine"
msgid "{cost} and goods"
msgstr ""

#. A cell in the comparison table, under the person: no one-time cost.
msgctxt "econ.machine.cmpOncePerson"
msgid "nothing"
msgstr ""

#. A cell in the comparison table, under the person: the going wage in the country. {wage} is an amount of money.
msgctxt "econ.machine.cmpWageOne"
msgid "{wage} in {country}"
msgstr ""

#. A cell in the comparison table, under the person: the going range of wages in the country. {lower} and {upper} are amounts of money.
msgctxt "econ.machine.cmpWageRange"
msgid "{lower} to {upper} in {country}"
msgstr ""

#. A cell in the comparison table, under the person: the owner chooses the wage.
msgctxt "econ.machine.cmpWageSet"
msgid "the wage you set"
msgstr ""

#. The first row of a table that compares an automation line with a person for one place: how much work each does in a day. Keep it short.
msgctxt "econ.machine.cmpWork"
msgid "Work a day"
msgstr ""

#. A cell in the comparison table, under the automation line: it works one short shift a day.
msgctxt "econ.machine.cmpWorkMachine"
msgid "1 short shift"
msgstr ""

#. A cell in the comparison table, under the person: a worker may work a short shift or a full one.
msgctxt "econ.machine.cmpWorkPerson"
msgid "a short or full shift"
msgstr ""

#. Said after "Worked" or "It last tried" when the date is not known.
msgctxt "econ.machine.dayRecently"
msgid "recently"
msgstr ""

#. Said after "Worked" or "It last tried".
msgctxt "econ.machine.dayToday"
msgid "today"
msgstr ""

#. Said after "Worked" or "It last tried".
msgctxt "econ.machine.dayYesterday"
msgid "yesterday"
msgstr ""

#. Said after "Worked" or "It last tried".
msgctxt "econ.machine.daysAgo"
msgid "{count, plural, one {1 day ago} other {{count} days ago}}"
msgstr ""

#. Said in the question that asks the reader to confirm taking an automation line out of a site. {credits} is an amount of money.
msgctxt "econ.machine.decommission"
msgid "Takes this automation line out of {name} for good and frees its place. The {credits} and the goods it was built from are not refunded."
msgstr ""

#. About a machine that did not work, when nothing says why.
msgctxt "econ.machine.didNotRun"
msgid "It did not run."
msgstr ""

#. About a company's fuel for its automation lines: how long it lasts.
msgctxt "econ.machine.fuelDays"
msgid "Fuel for about {days, plural, one {1 day} other {{days} days}}: {held} held, {all} a day."
msgstr ""

#. About a company's fuel for its automation lines.
msgctxt "econ.machine.fuelOut"
msgid "Out of fuel: {held} held, and a line burns {perDay} a day. Idle at no cost until fuel arrives."
msgstr ""

#. About a company's fuel for its automation lines: enough for some of them.
msgctxt "econ.machine.fuelSome"
msgid "Fuel for {some} of the {lines} lines today: {held} held, {all} a day."
msgstr ""

#. Why a machine cannot be installed. {name} is a site's name. A job listing is an advert for workers.
msgctxt "econ.machine.full"
msgid "Every place at {name} is taken. Let somebody go, close a job listing, or raise the facility a level. People and automation lines share the same {total} places."
msgstr ""

#. Said in the question that asks the reader to confirm installing an automation line. {credits} is an amount of money; the other three are quantities of goods such as "40 industrial components".
msgctxt "econ.machine.installConsequence"
msgid "Takes {credits}, {components} and {materials}, none of it refunded. The line then burns {fuel} on each day it works."
msgstr ""

#. About a machine just put in. {since} is a length of time such as "3 hours".
msgctxt "econ.machine.installedAgo"
msgid "Installed {since} ago. It has not been asked to work yet."
msgstr ""

#. About a machine just put in.
msgctxt "econ.machine.installedNow"
msgid "Installed just now. It has not been asked to work yet."
msgstr ""

#. About a machine that did not work. {when} is yesterday or a number of days ago; {said} is the reason the machine gave, in a sentence.
msgctxt "econ.machine.lastTried"
msgid "It last tried {when} and did not run. It said: “{said}”"
msgstr ""

#. What an automation line is. A shift is a day's turn at work.
msgctxt "econ.machine.lead"
msgid "An automation line works one short shift a day in one of this building's places, with nobody to hire or pay."
msgstr ""

#. About a site's machines, which have not yet been given a turn today.
msgctxt "econ.machine.notAsked"
msgid "{total, plural, one {Its automation line has not been asked to work yet today.} other {Its {total} automation lines have not been asked to work yet today.}}"
msgstr ""

#. Why a machine cannot be installed yet. {name} is a site's name.
msgctxt "econ.machine.notBuilt"
msgid "{name} is still being built. A place there can be automated once it opens."
msgstr ""

#. Why a machine cannot be installed. {name} is a site's name.
msgctxt "econ.machine.notOpen"
msgid "{name} is not open, so nothing can be installed there."
msgstr ""

#. About a machine that did not run: it has used up its tries for the day.
msgctxt "econ.machine.restsTomorrow"
msgid "It has tried {count, plural, one {1 time} other {{count} times}} today and rests until tomorrow."
msgstr ""

#. Said in place of the Automate button when the company has too little money. {have} and {cost} are amounts of money.
msgctxt "econ.machine.shortOfMoney"
msgid "The company has {have} and automating a place costs {cost}. Put money into the company on its page."
msgstr ""

#. One part of a site's staffing line: places a job advert is holding for people not yet hired.
msgctxt "econ.machine.staffAdvertised"
msgid "{count} advertised"
msgstr ""

#. The shape of a site, before anything is offered: how many places it has, and none are taken. A place is room for one person or one automation line.
msgctxt "econ.machine.staffAllEmpty"
msgid "{total, plural, one {1 place} other {{total} places}}, all empty."
msgstr ""

#. One part of a site's staffing line: places with nobody and nothing in them.
msgctxt "econ.machine.staffEmpty"
msgid "{count} empty"
msgstr ""

#. One part of a site's staffing line: machines that work in its places.
msgctxt "econ.machine.staffLines"
msgid "{count, plural, one {1 automation line} other {{count} automation lines}}"
msgstr ""

#. One part of a site's staffing line: every place is taken.
msgctxt "econ.machine.staffNoneEmpty"
msgid "none empty"
msgstr ""

#. The shape of a site that has more people and machines than places, because it lost a level. {parts} is a list joined with commas.
msgctxt "econ.machine.staffOver"
msgid "{total, plural, one {1 place} other {{total} places}}: {parts} · {extra, plural, one {1 place} other {{extra} places}} more than the building holds, because it was dropped a level after they were filled. Nothing new goes in until somebody leaves or an automation line comes out."
msgstr ""

#. One part of a site's staffing line: people working in its places.
msgctxt "econ.machine.staffPeople"
msgid "{count, plural, one {1 person} other {{count} people}}"
msgstr ""

#. The shape of a site: how many places it has, then what is in them. {parts} is a list joined with commas, such as "3 people, 2 advertised, 4 empty".
msgctxt "econ.machine.staffSentence"
msgid "{total, plural, one {1 place} other {{total} places}}: {parts}."
msgstr ""

#. About a site's machines, none of which has worked today.
msgctxt "econ.machine.stoppedAll"
msgid "{total, plural, one {Its automation line has not worked yet today.} other {None of its {total} automation lines has worked yet today.}}"
msgstr ""

#. About a site's one machine, which has not worked today. {why} is the cause, a short sentence with its own full stop.
msgctxt "econ.machine.stoppedOneWhy"
msgid "Its automation line has not worked yet today: {why}"
msgstr ""

#. About a site's machines, some of which have not worked today.
msgctxt "econ.machine.stoppedSome"
msgid "{stopped} of its {total} automation lines have not worked yet today."
msgstr ""

#. About a machine that did not run: how many times it was asked to work today.
msgctxt "econ.machine.triedToday"
msgid "It has tried {count, plural, one {1 time} other {{count} times}} today."
msgstr ""

#. About a machine that did not run. {hour} is a clock time such as 14:30 on the world clock (UTC).
msgctxt "econ.machine.triesAt"
msgid "It tries again at {hour} world time, or as soon as goods arrive in the company's store."
msgstr ""

#. About a machine that did not run.
msgctxt "econ.machine.triesTomorrow"
msgid "It tries again tomorrow, or sooner if goods arrive in the company's store."
msgstr ""

#. About a site's machines, all of which worked today.
msgctxt "econ.machine.workedAll"
msgid "{total, plural, one {Its automation line worked today.} other {All {total} of its automation lines worked today.}}"
msgstr ""

#. About a machine that failed earlier today and then worked. {hour} is a clock time such as 14:30 on the world clock (UTC); the number is 2nd, 3rd, 4th and so on.
msgctxt "econ.machine.workedRetry"
msgid "Worked today at {hour} world time, on its {attempt, selectordinal, one {{attempt}st} two {{attempt}nd} few {{attempt}rd} other {{attempt}th}} try."
msgstr ""

#. About a site's machines, some of which have worked today.
msgctxt "econ.machine.workedSome"
msgid "{worked, plural, one {1 of its {total} automation lines has worked today.} other {{worked} of its {total} automation lines have worked today.}}"
msgstr ""

#. About a machine: it worked on a day. {when} is today, yesterday or a number of days ago.
msgctxt "econ.machine.workedWhen"
msgid "Worked {when}."
msgstr ""

#. Said beside the cost of making one unit of a good, which is shown as a large figure before this sentence. {total} is an amount of money; a run is one go at the recipe.
msgctxt "econ.made.costWords"
msgid "of inputs per unit, at what this market charges for them today. {total} buys one run."
msgstr ""

#. How a raw good comes out of the ground, in the sentence "It is {how}, on land that has it".
msgctxt "econ.made.fromFarm"
msgid "grown on farmland"
msgstr ""

#. How a raw good comes out of the ground, in the sentence "It is {how}, on land that has it".
msgctxt "econ.made.fromForest"
msgid "cut in a forest"
msgstr ""

#. How a raw good comes out of the ground, in the sentence "It is {how}, on land that has it".
msgctxt "econ.made.fromGround"
msgid "taken straight out of the ground"
msgstr ""

#. How a raw good comes out of the ground, in the sentence "It is {how}, on land that has it".
msgctxt "econ.made.fromMine"
msgid "dug out of a mine"
msgstr ""

#. How a raw good comes out of the ground, in the sentence "It is {how}, on land that has it".
msgctxt "econ.made.fromOil"
msgid "pumped out of an oil field"
msgstr ""

#. The label of a list of goods that a good is an ingredient of.
msgctxt "econ.made.goesInto"
msgid "Goes into"
msgstr ""

#. The label of the list of ingredients on a recipe card.
msgctxt "econ.made.madeFrom"
msgid "Made from"
msgstr ""

#. The accessible name of a recipe card. {good} is the good's name in lower case.
msgctxt "econ.made.madeOf"
msgid "What {good} is made of"
msgstr ""

#. Said when a good is not an ingredient of anything. {good} is the good's name in lower case.
msgctxt "econ.made.noFactory"
msgid "No factory turns {good} into anything."
msgstr ""

#. The label on a recipe card for a raw good, which is taken from the ground rather than made.
msgctxt "econ.made.notMade"
msgid "Not made from anything"
msgstr ""

#. Said under the list of ingredients on a recipe card. {labour} is such as "10 shifts of labour"; {units} is such as "5 units"; {good} is the good's name in lower case.
msgctxt "econ.made.oneRun"
msgid "One run of that, plus {labour}, makes {units} of {good}."
msgstr ""

#. Joins the names of goods nobody sells, one pair at a time: "iron or coal", then "iron or coal or tin".
msgctxt "econ.made.or"
msgid "{first} or {second}"
msgstr ""

#. Said on the recipe card of a raw good. {good} is the good's name in lower case; {how} is a short phrase such as "dug out of a mine"; {labour} is such as "10 shifts of labour"; {units} is such as "5 units". A run is one go at the recipe.
msgctxt "econ.made.raw"
msgid "Nothing is turned into {good}. It is {how}, on land that has it: a run takes {labour} and brings back {units}."
msgstr ""

#. How much work one run of a recipe takes. A shift is a worker's day of work.
msgctxt "econ.made.shifts"
msgid "{count, plural, one {one shift of labour} other {{count} shifts of labour}}"
msgstr ""

#. A number of units of a good.
msgctxt "econ.made.units"
msgid "{count, plural, one {1 unit} other {{count} units}}"
msgstr ""

#. Said on a recipe card when an ingredient has no price. {goods} is the goods' names joined with "or".
msgctxt "econ.made.unpriced"
msgid "Nobody is selling {goods} right now, so what a unit costs to make cannot be added up yet."
msgstr ""

#. The line under "Goes into" that says what in the world uses a good up directly. {uses} is one or more short phrases joined with "; "; the full stop is added here.
msgctxt "econ.made.usedBy"
msgid "{uses}."
msgstr ""

#. The accessible name of the part of a recipe card that says what a good goes into. {good} is the good's name in lower case.
msgctxt "econ.made.usedFor"
msgid "What {good} is used for"
msgstr ""

#. The accessible name of a recipe card for a raw good. {good} is the good's name in lower case.
msgctxt "econ.made.whereFrom"
msgid "Where {good} comes from"
msgstr ""

#. The button that confirms buying an item. {price} is an amount of money with CR.
msgctxt "econ.market.buyFor"
msgid "Buy · {price}"
msgstr ""

#. The label of the choice between the companies the reader runs, shown when they run several. Means a company the reader trades for.
msgctxt "econ.market.company"
msgid "Corporation"
msgstr ""

#. Shown when an act on the market was refused and the server gave no reason. "Market" is the name of a screen.
msgctxt "econ.market.couldNot"
msgid "The Market could not do that."
msgstr ""

#. Said where a sell control would be, when the reader trades as a country. The national stockpile is the goods a country holds.
msgctxt "econ.market.countryBuys"
msgid "A country buys on the market. Selling out of the national stockpile is a different act, and this is not it."
msgstr ""

#. Shown when reading the market failed and the server gave no reason. "Market" is the name of a screen.
msgctxt "econ.market.noAnswer"
msgid "The Market did not answer."
msgstr ""

#. The accessible name of the control that lets the reader set their own price. {price} is an amount of money, the price the market would charge.
msgctxt "econ.market.ownPriceIs"
msgid "Set your own price: {price}"
msgstr ""

#. Shown when a request to the market failed and the server gave no reason.
msgctxt "econ.market.requestFailed"
msgid "The market could not complete that request."
msgstr ""

#. The accessible name of a button that takes the reader's own order or listing off the market. {what} says which one, such as "your offer to buy 3 food" or an item's name.
msgctxt "econ.market.takeBack"
msgid "Take back {what}"
msgstr ""

#. The name of the reader as a trader on the market, beside the companies the reader may trade as.
msgctxt "econ.market.you"
msgid "You"
msgstr ""

msgctxt "econ.modelCategory.aircraft"
msgid "An aircraft"
msgstr ""

msgctxt "econ.modelCategory.artillery"
msgid "An artillery piece"
msgstr ""

msgctxt "econ.modelCategory.groundVehicle"
msgid "A ground vehicle"
msgstr ""

#. What kind of thing a company's model is: armour one person wears.
msgctxt "econ.modelCategory.personalArmor"
msgid "Armour somebody wears"
msgstr ""

#. What kind of thing a company's model is: a weapon one person carries.
msgctxt "econ.modelCategory.personalWeapon"
msgid "A weapon somebody carries"
msgstr ""

#. Shown when a movement of money was refused and the server gave no reason.
msgctxt "econ.money.didNotMove"
msgid "That money did not move."
msgstr ""

#. A public programme: the state buys goods from companies that apply.
msgctxt "econ.programKind.procurement"
msgid "goods the state is buying"
msgstr ""

#. A public programme: money the state pays out to those who apply.
msgctxt "econ.programKind.subsidy"
msgid "money the state pays out"
msgstr ""

#. How far a world project reaches: every player.
msgctxt "econ.projectScope.global"
msgid "Everybody"
msgstr ""

#. How far a world project reaches: one region of the world.
msgctxt "econ.projectScope.regional"
msgid "One region"
msgstr ""

#. Said after the notice that a vote on buying a company is under way, once the vote has ended.
msgctxt "econ.purchase.closed"
msgid "The vote has closed; the result lands within the minute."
msgstr ""

#. Said after the notice that a vote on buying a company is under way. {left} is a length of time.
msgctxt "econ.purchase.closesIn"
msgid "The vote closes in {left}."
msgstr ""

#. The accessible name of the notice that a country's parliament is voting on buying a company.
msgctxt "econ.purchase.label"
msgid "A bill to buy this company"
msgstr ""

#. A link to the law that would buy a company.
msgctxt "econ.purchase.read"
msgid "Read the bill"
msgstr ""

#. A notice on a company's page. {country} is the country's name with its flag, and "the" where English needs it; {ending} is the English possessive ending (an apostrophe, "'s" or nothing): leave it out if your language does not write it that way. The chamber is the country's parliament.
msgctxt "econ.purchase.vote"
msgid "{country}{ending} chamber is voting on buying this company for the country. If it carries, every shareholder is paid for their shares: what its sites and stock are worth plus a quarter, and its money, less what it owes."
msgstr ""

#. A link to the Work screen to apply for a job.
msgctxt "econ.record.apply"
msgid "Apply on Work"
msgstr ""

#. A link to the Work screen to apply for a job. {wage} is an amount of money.
msgctxt "econ.record.applyWage"
msgid "Apply on Work · {wage} a shift"
msgstr ""

#. A number of a company's sites that are still under construction, after "2 sites ·".
msgctxt "econ.record.building"
msgid "{count} being built"
msgstr ""

#. Under a price: the price of one unit, before freight.
msgctxt "econ.record.each"
msgid "each, before delivery"
msgstr ""

#. A link from a job advert in a province the reader is not in. {province} is the province's name.
msgctxt "econ.record.faraway"
msgid "In {province}: you work where you stand, so travel there to take it"
msgstr ""

#. Under a goods name on a company's market offer, when it is delivered from the company's store instead of from a province.
msgctxt "econ.record.fromStore"
msgid "Delivered from store"
msgstr ""

#. A heading above a company's open job adverts.
msgctxt "econ.record.hiring"
msgid "Taking people on"
msgstr ""

#. The accessible name of the panel that says what a company makes, sells and offers.
msgctxt "econ.record.label"
msgid "What this company does"
msgstr ""

#. A heading above the goods a company makes.
msgctxt "econ.record.makes"
msgid "What it makes"
msgstr ""

#. Said in the panel that says what a company does, when it has no site.
msgctxt "econ.record.nothing"
msgid "It has no site yet, so it makes nothing, sells nothing and employs nobody."
msgstr ""

#. A heading above the goods a company is offering on the market now.
msgctxt "econ.record.onMarket"
msgid "On the market now"
msgstr ""

#. A link to the market, from a company's page.
msgctxt "econ.record.openMarket"
msgid "Open the market to buy from it"
msgstr ""

#. Under a wage in an open job advert: it is per shift, and how many places are open.
msgctxt "econ.record.openings"
msgid "a shift · {count, plural, one {1 opening} other {{count} openings}}"
msgstr ""

#. Under a wage in an open job advert: it is per shift, how many places are open, and the lowest level a worker needs.
msgctxt "econ.record.openingsLevel"
msgid "a shift · {count, plural, one {1 opening} other {{count} openings}} · level {level} and up"
msgstr ""

#. The word under a number of people (the number is shown separately, above it).
msgctxt "econ.record.person"
msgid "{count, plural, one {person} other {people}}"
msgstr ""

#. A number of sites (a company's workplaces).
msgctxt "econ.record.sites"
msgid "{count, plural, one {1 site} other {{count} sites}}"
msgstr ""

#. The heading of the panel that says what a company makes, sells and offers, when it does nothing yet.
msgctxt "econ.record.whatItDoes"
msgid "What it does"
msgstr ""

#. A heading above the provinces where a company has sites.
msgctxt "econ.record.where"
msgid "Where it works"
msgstr ""

#. Said after the loan's length. Nothing is due until the last day, then all of it is.
msgctxt "econ.repayment.atMaturity"
msgid "all of it on the last day"
msgstr ""

#. Said after the loan's length, as in "30 days · paid every day".
msgctxt "econ.repayment.daily"
msgid "paid every day"
msgstr ""

msgctxt "econ.repayment.weekly"
msgid "paid every week"
msgstr ""

#. A cross line: the research costs more than the office the reader holds may spend without a law.
msgctxt "econ.research.aboveLimit"
msgid "Above what your office may spend on its own"
msgstr ""

#. Why research costs what it does, for a country so poor that it pays the lowest price. {daily} is an amount of money.
msgctxt "econ.research.basisFloor"
msgid "The least a tier {tier} costs: {country} takes in {daily} a day."
msgstr ""

#. Why research costs what it does: its price is a number of days of the country's income. {daily} is an amount of money.
msgctxt "econ.research.basisIncome"
msgid "{days} days of what {country} takes in ({daily} a day), so it moves day to day."
msgstr ""

#. What to do when the stockpile lacks goods for research. "Market" is the name of a screen.
msgctxt "econ.research.buyGoods"
msgid "Buy {count} {goods} for the country on the Market"
msgstr ""

#. The price of research: money, then two kinds of goods already joined ("A and B"). {credits} is an amount of money.
msgctxt "econ.research.costWithMany"
msgid "{credits}, {goods}"
msgstr ""

#. The price of research: money and one kind of goods. {credits} is an amount of money.
msgctxt "econ.research.costWithOne"
msgid "{credits} and {goods}"
msgstr ""

#. A discount on research because another country already has it.
msgctxt "econ.research.discount"
msgid "{percent}% off: another country got there first."
msgstr ""

#. The heading of a research price. A tier is a level in a branch of research.
msgctxt "econ.research.head"
msgid "Tier {tier} of {branch}"
msgstr ""

#. What to do when the research costs more than the reader's office may spend. "Laws" is the name of a screen.
msgctxt "econ.research.lawInstead"
msgid "A law can order it instead: propose a research order in Laws."
msgstr ""

#. A tick-or-cross line: the country's stockpile holds {have} of the {need} the research costs, of one kind of goods ({goods} is its plural name).
msgctxt "econ.research.stockpile"
msgid "Stockpile: {have} of {need} {goods}"
msgstr ""

#. How long research takes. {length} is a short length of time such as "3d" or "5h 20m".
msgctxt "econ.research.time"
msgid "Takes about {length}, and cannot be stopped."
msgstr ""

#. A tick-or-cross line: the country's treasury holds {have} of the {need} the research costs. Both are amounts of money.
msgctxt "econ.research.treasury"
msgid "Treasury: {have} of {need}"
msgstr ""

#. What to do when the treasury lacks money for research. {short} is an amount of money. "Money" is the name of a tab.
msgctxt "econ.research.treasuryShort"
msgid "The Treasury is {short} short. What comes in each day is on the country's Money tab."
msgstr ""

#. A tick line: the research costs no more than the office the reader holds may spend without a law.
msgctxt "econ.research.withinLimit"
msgid "Within what your office may spend"
msgstr ""

#. The label and hint of the search box above a long list of people.
msgctxt "econ.roster.find"
msgid "Find by name"
msgstr ""

#. The button that shows the next page of a long list. {count} is how many it adds; {left} is how many are still hidden.
msgctxt "econ.roster.more"
msgid "Show {count} more ({left} left)"
msgstr ""

#. Said when no shares are left in a sale.
msgctxt "econ.sale.allBought"
msgid "Every share on sale has been bought."
msgstr ""

#. Said beside the bid field. {floor} is an amount of money, the lowest bid allowed.
msgctxt "econ.sale.atLeast"
msgid "At least {floor}."
msgstr ""

#. A second line of the rule of a sale by sealed bids.
msgctxt "econ.sale.auctionNote"
msgid "Nobody sees another bid. You get one bid, and it cannot be changed or taken back."
msgstr ""

#. The rule of a sale by sealed bids: nobody sees the other bids. {when} is a date and time; {floor} is an amount of money, the lowest bid allowed.
msgctxt "econ.sale.auctionRule"
msgid "Sealed bids until {when}: the highest bid of at least {floor} buys the whole company, and every other bid comes back in full."
msgstr ""

#. The heading of a state company that its country is selling to the highest bidder. {seller} is the country's name, with its flag, and "the" where English needs it.
msgctxt "econ.sale.auctionTitle"
msgid "For sale by {seller}"
msgstr ""

#. The button that confirms a bid. {amount} is a number such as 4 500.00; CR is the game's money.
msgctxt "econ.sale.bidAct"
msgid "Bid {amount} CR"
msgstr ""

#. The button that starts a bid. A sealed bid is one nobody else can see.
msgctxt "econ.sale.bidButton"
msgid "Place a sealed bid"
msgstr ""

#. Said in the question that asks the reader to confirm a bid. {amount} is a number such as 4 500.00; {when} is a date and time; {country} is the selling country's name, with "the" where English needs it.
msgctxt "econ.sale.bidConsequence"
msgid "{amount} CR leaves your wallet now and is held until {when}. If yours is the highest bid, it pays {country} and the company is yours to run. If not, all of it comes back."
msgstr ""

#. Said after a bid was placed. {amount} is a number such as 4 500.00.
msgctxt "econ.sale.bidDone"
msgid "Your sealed bid of {amount} CR is in."
msgstr ""

#. The label of the field where the reader types a bid. CR is the game's money.
msgctxt "econ.sale.bidLabel"
msgid "Your bid, CR"
msgstr ""

#. The question that asks the reader to confirm a bid. {amount} is a number such as 4 500.00; CR is the game's money; {company} is a company's name.
msgctxt "econ.sale.bidQuestion"
msgid "Bid {amount} CR for {company}?"
msgstr ""

#. Said when the time for bids has ended.
msgctxt "econ.sale.biddingClosed"
msgid "Bidding has closed. The result is worked out within ten minutes."
msgstr ""

#. The button that confirms buying shares. {total} is a number such as 4 500.00; CR is the game's money.
msgctxt "econ.sale.buyAct"
msgid "Buy for {total} CR"
msgstr ""

#. The button that starts buying shares.
msgctxt "econ.sale.buyButton"
msgid "Buy shares"
msgstr ""

#. Said in the question that asks the reader to confirm buying shares. {total} is a number such as 4 500.00; {owner} is the selling country's name with "the" where English needs it, in the possessive ("the United States's"); {percent} is a share such as 10%.
msgctxt "econ.sale.buyConsequence"
msgid "{total} CR leaves your wallet for {owner} Treasury now, for {count, plural, one {1 share} other {{count} shares}} ({percent} of {company})."
msgstr ""

#. Said after shares were bought.
msgctxt "econ.sale.buyDone"
msgid "You bought {count, plural, one {1 share} other {{count} shares}}."
msgstr ""

#. The question that asks the reader to confirm buying shares. {company} is a company's name.
msgctxt "econ.sale.buyQuestion"
msgid "Buy {count, plural, one {1 share} other {{count} shares}} of {company}?"
msgstr ""

#. Said when the time for a sale of shares has ended.
msgctxt "econ.sale.closed"
msgid "This sale has closed."
msgstr ""

#. Said beside the shares field. {price} is an amount of money.
msgctxt "econ.sale.eachShare"
msgid "Each share is {price}."
msgstr ""

#. How long a sale has left, such as "2d 4h left". {left} is a length of time.
msgctxt "econ.sale.left"
msgid "{left} left"
msgstr ""

#. Shown under the field where the reader types how many shares to buy, when it costs more than the reader has. {total} and {wallet} are amounts of money.
msgctxt "econ.sale.problemCost"
msgid "{count, plural, one {1 share costs {total}, and your wallet holds {wallet}.} other {{count} shares cost {total}, and your wallet holds {wallet}.}}"
msgstr ""

#. Shown under the bid field. {floor} is an amount of money, the lowest bid allowed.
msgctxt "econ.sale.problemFloor"
msgid "A bid has to be at least {floor}."
msgstr ""

#. Shown under the field where the reader types how many shares to buy, when it is more than the sale has left.
msgctxt "econ.sale.problemLeft"
msgid "{count, plural, one {Only 1 share is left.} other {Only {count} shares are left.}}"
msgstr ""

#. Shown under the field where the reader types how many shares to buy.
msgctxt "econ.sale.problemShares"
msgid "Write a whole number of shares, like 1000."
msgstr ""

#. Shown under the bid field when what was typed is not an amount. CR is the game's money.
msgctxt "econ.sale.problemSum"
msgid "Write a sum in CR, like 4500."
msgstr ""

#. Shown under the bid field when the bid is more than the reader has. {wallet} is an amount of money.
msgctxt "econ.sale.problemWallet"
msgid "Your wallet holds {wallet}."
msgstr ""

#. The accessible name of the area that answers a purchase of the last shares in a sale.
msgctxt "econ.sale.purchase"
msgid "Your purchase"
msgstr ""

#. A link to the reader's own shares.
msgctxt "econ.sale.seeShares"
msgid "See your shares"
msgstr ""

#. Said beside the shares field once a number is typed. {portion} is what part of the company that is, such as "10% of it"; {total} is an amount of money.
msgctxt "econ.sale.sharesIs"
msgid "{count, plural, one {1 share is {portion}, for {total}.} other {{count} shares is {portion}, for {total}.}}"
msgstr ""

#. The label of the field where the reader types how many shares to buy.
msgctxt "econ.sale.sharesLabel"
msgid "How many shares"
msgstr ""

#. A second line of the rule of a sale of shares.
msgctxt "econ.sale.sharesNote"
msgid "Once the country holds half the shares or fewer, it no longer owns the company, and whoever holds the most shares runs it."
msgstr ""

#. The rule of a sale of shares at a fixed price. {price} is an amount of money; {when} is a date and time. The Treasury is the country's own money.
msgctxt "econ.sale.sharesRule"
msgid "{count, plural, one {1 share} other {{count} shares}} left at {price} each, until {when}: first come, first served. The money goes to the country's Treasury."
msgstr ""

#. The heading of a state company whose country is selling shares at a fixed price. {seller} is the country's name, with its flag, and "the" where English needs it.
msgctxt "econ.sale.sharesTitle"
msgid "Shares for sale by {seller}"
msgstr ""

#. Said to a reader who is not signed in, in place of the bid form.
msgctxt "econ.sale.signInBid"
msgid "Sign in to bid."
msgstr ""

#. Said to a reader who is not signed in, in place of the buy form.
msgctxt "econ.sale.signInShares"
msgid "Sign in to buy shares."
msgstr ""

#. Said beside a field where the reader types an amount. {wallet} is the money in the reader's wallet.
msgctxt "econ.sale.youHave"
msgid "You have {wallet}."
msgstr ""

#. Said to the person who runs a state company for its country, in place of the bid form. {seller} is the country's name, with its flag. The chamber is the country's parliament.
msgctxt "econ.sale.youRunIt"
msgid "You run this company for {seller}, so you cannot bid for it. If the chamber sells its shares at a fixed price, you may buy them like anyone."
msgstr ""

#. Said once the reader has bid. {bid} is an amount of money; {when} is a date and time. The money is held until the sale ends.
msgctxt "econ.sale.yourBid"
msgid "Your sealed bid: {bid}. It cannot be changed or taken back. Held until {when}. You will be told how it ended."
msgstr ""

#. A line under the choice of shift. "Full" is the name of the longer of two shifts a worker may choose; {facility} is the name of the workplace.
msgctxt "econ.shift.fullGives"
msgid "Full gives {facility} {units, plural, =2 {two shifts} one {1 shift} other {{units} shifts}} of work."
msgstr ""

#. Why the work button is not offered. Energy is the game's name for a player's stamina.
msgctxt "econ.shift.noEnergy"
msgid "A shift costs {cost} Energy and you have {have}. Energy comes back on its own every hour."
msgstr ""

#. Why the work button is not offered: the day's one shift was worked at another workplace. The world day turns over at midnight UTC.
msgctxt "econ.shift.workedElsewhere"
msgid "You have already worked today's shift somewhere else. The next one opens when the world day turns over."
msgstr ""

#. Why the work button is not offered. The world day turns over at midnight UTC.
msgctxt "econ.shift.workedToday"
msgid "You have already worked your shift today. The next one opens when the world day turns over."
msgstr ""

#. Why the work button is not offered.
msgctxt "econ.shift.wrongProvince"
msgid "Your workplace is in {province}. You have to be there to work a shift."
msgstr ""

#. Said in the question that asks the reader to confirm putting goods into a company's store. {goods} is a quantity such as "40 iron"; {site} is a site's name.
msgctxt "econ.site.deposit"
msgid "Moves {goods} out of your own pack into {site}'s store. They become the company's, and this does not give them back. The company pays the ordinary freight from where you are standing to the site."
msgstr ""

#. Finished goods such as weapons, counted one by one, in a site's store.
msgctxt "econ.site.items"
msgid "{count, plural, one {1 finished item} other {{count} finished items}}"
msgstr ""

#. The last sentences of the question that asks the owner to confirm pulling a site down.
msgctxt "econ.site.notReturned"
msgid "The credits spent building it are not returned. This cannot be undone."
msgstr ""

#. What comes back when a site is pulled down and nothing is recovered. Lower case, after "You get back".
msgctxt "econ.site.nothing"
msgid "nothing"
msgstr ""

#. The first sentence of the question that asks the owner to confirm pulling a site down. {name} is the site's name.
msgctxt "econ.site.pullsDown"
msgid "Pulls down {name} for good."
msgstr ""

#. Said before a site is pulled down, when no other site was chosen to receive what is recovered. {salvage} is a list of materials such as "480 construction materials".
msgctxt "econ.site.returnsLost"
msgid "You get back {salvage} from the building, but with nowhere chosen to take it, it is lost."
msgstr ""

#. Said before a site is pulled down, when no other site was chosen to receive what is recovered. {salvage} is a list of materials such as "480 construction materials"; {stock} is what is in the store.
msgctxt "econ.site.returnsLostStock"
msgid "You get back {salvage} from the building, but with nowhere chosen to take it, that and the {stock} in its store are lost."
msgstr ""

#. Said before a site is pulled down. {name} is the site that receives the goods and {province} the province it is in.
msgctxt "econ.site.returnsMoved"
msgid "You get back {salvage} from the building. It goes to {name} in {province}."
msgstr ""

#. Said before a site is pulled down. {freight} is an amount of money. The treasury is the company's own money.
msgctxt "econ.site.returnsMovedFreight"
msgid "You get back {salvage} from the building. It goes to {name} in {province}, and carrying it there costs {freight} from the treasury."
msgstr ""

#. Said before a site is pulled down. {name} is the site that receives the goods and {province} the province it is in.
msgctxt "econ.site.returnsMovedStock"
msgid "You get back {salvage} from the building. It and the {stock} in the store go to {name} in {province}."
msgstr ""

#. Said before a site is pulled down. {freight} is an amount of money. The treasury is the company's own money.
msgctxt "econ.site.returnsMovedStockFreight"
msgid "You get back {salvage} from the building. It and the {stock} in the store go to {name} in {province}, and carrying it there costs {freight} from the treasury."
msgstr ""

#. Said before a site is pulled down: what happens to its adverts for workers.
msgctxt "econ.site.stopsAdverts"
msgid "{count, plural, one {1 job advert closes, and anyone waiting on it is told.} other {{count} job adverts close, and anyone waiting on them is told.}}"
msgstr ""

#. Said before a site is pulled down: what happens to its machines.
msgctxt "econ.site.stopsMachines"
msgid "{count, plural, one {1 automation line comes out, with nothing back for it.} other {{count} automation lines come out, with nothing back for them.}}"
msgstr ""

#. Said before a site is pulled down: what happens to its buy and sell orders on the market.
msgctxt "econ.site.stopsOrders"
msgid "{count, plural, one {1 market order comes off the market first.} other {{count} market orders come off the market first.}}"
msgstr ""

#. Said before a site is pulled down: what happens to its workers.
msgctxt "econ.site.stopsWorkers"
msgid "{count, plural, one {1 person works there and loses the job today. They are told why.} other {{count} people work there and lose their jobs today. They are told why.}}"
msgstr ""

#. Units of goods in a site's store, as in "480 units".
msgctxt "econ.site.units"
msgid "{count, plural, one {1 unit} other {{count} units}}"
msgstr ""

#. Said in the question that asks the owner to confirm raising a site one level. {list} is what it costs; {length} is a short length of time.
msgctxt "econ.site.upgrade"
msgid "{list}. It stops producing for about {length}."
msgstr ""

#. Said in the question that asks the owner to confirm raising a site one level. {list} is what it costs, such as "500.00 CR, 40 construction materials and 10 industrial components"; {length} is a short length of time.
msgctxt "econ.site.upgradeBuys"
msgid "{list}, bought on the market if the company is short. It stops producing for about {length}."
msgstr ""

#. Explains, above the form for pulling a site down, why there is no way to move a site or change what it makes.
msgctxt "econ.siteActions.cannotMove"
msgid "A building cannot be moved or turned into another kind. To make something else, or to make it somewhere else, pull this one down and open another place: part of what it was built from comes back to help pay for the new one."
msgstr ""

#. Said above the choice of goods to put into a site. {site} is a site's name.
msgctxt "econ.siteActions.choose"
msgid "Choose what to put into {site} from your own pack."
msgstr ""

#. Under a kind of goods in the reader's pack: how many the reader holds.
msgctxt "econ.siteActions.held"
msgid "{count} held"
msgstr ""

#. The label of the field where the reader types how many to put into a site.
msgctxt "econ.siteActions.howMany"
msgid "How many"
msgstr ""

#. Under the choice "Nowhere": the recovered goods and the store are lost.
msgctxt "econ.siteActions.letGo"
msgid "Let it all go"
msgstr ""

#. Shown while the reader's pack is being read. The pack is what a citizen carries.
msgctxt "econ.siteActions.looking"
msgid "Looking in your pack…"
msgstr ""

#. A choice in the list of sites to send recovered goods to: none, and they are lost.
msgctxt "econ.siteActions.nowhere"
msgid "Nowhere"
msgstr ""

#. Under the choice "Nowhere", when the company has no other site that could receive the goods.
msgctxt "econ.siteActions.onlySite"
msgid "It is your only working site"
msgstr ""

#. Said when the reader's pack has nothing a site can take in.
msgctxt "econ.siteActions.packEmpty"
msgid "Your pack holds nothing this site can store. Goods you buy for yourself on the market, or are given, land in your pack; from there they can go into any of your company's working sites."
msgstr ""

#. The accessible name of the choice of goods in the reader's pack.
msgctxt "econ.siteActions.packGoods"
msgid "Goods in your pack"
msgstr ""

#. The button in the question that confirms pulling a site down. {site} is a site's name.
msgctxt "econ.siteActions.pullAct"
msgid "Pull down {site}"
msgstr ""

#. The button that starts pulling a site down. {site} is a site's name.
msgctxt "econ.siteActions.pullButton"
msgid "Pull down {site}"
msgstr ""

#. Said after a site was pulled down. {site} is a site's name.
msgctxt "econ.siteActions.pullDone"
msgid "{site} has been pulled down."
msgstr ""

#. The question that asks an owner to confirm pulling a site down. {site} is a site's name.
msgctxt "econ.siteActions.pullQuestion"
msgid "Pull down {site}?"
msgstr ""

#. The button that puts goods from the reader's pack into a site. {amount} is a number; {goods} is the goods' name; {site} is a site's name.
msgctxt "econ.siteActions.putIn"
msgid "Put {amount} {goods} into {site}"
msgstr ""

#. Shown when the cost of pulling a site down could not be fetched.
msgctxt "econ.siteActions.quoteFailed"
msgid "The price of pulling it down could not be read. Try again in a moment."
msgstr ""

#. Said under the quantity field when what was typed is not allowed. {most} is how many the reader holds.
msgctxt "econ.siteActions.range"
msgid "A whole number from 1 to {most}: that is how many you hold."
msgstr ""

#. A label above the choice of the site that receives the materials recovered from a pulled-down site and the goods in its store.
msgctxt "econ.siteActions.whereGo"
msgid "Where the salvage and the store go"
msgstr ""

#. Shown while the game works out what an owner gets back for pulling a site down.
msgctxt "econ.siteActions.working"
msgid "Working out what comes back…"
msgstr ""

#. A length of time in whole days, as in "in 5 days" or "3 days ago".
msgctxt "econ.span.days"
msgid "{count, plural, one {1 day} other {{count} days}}"
msgstr ""

#. A length of time in whole hours, as in "in 5 hours" or "3 hours ago".
msgctxt "econ.span.hours"
msgid "{count, plural, one {1 hour} other {{count} hours}}"
msgstr ""

#. A length of time in whole minutes, as in "in 5 minutes" or "3 minutes ago".
msgctxt "econ.span.minutes"
msgid "{count, plural, one {1 minute} other {{count} minutes}}"
msgstr ""

#. A length of time shorter than a minute, as in "in under a minute".
msgctxt "econ.span.underMinute"
msgid "under a minute"
msgstr ""

#. A note on a company's people page, for somebody who does not run the company: job adverts the company has out.
msgctxt "econ.staff.advertisedMore"
msgid "{places, plural, one {1 more place is advertised.} other {{places} more places are advertised.}}"
msgstr ""

#. A note on a company's people page, for an owner: job adverts the owner has out.
msgctxt "econ.staff.advertisingMore"
msgid "You are advertising {places, plural, one {1 more place} other {{places} more places}}."
msgstr ""

#. The headline of a company's people page.
msgctxt "econ.staff.allWorked"
msgid "{staff, plural, one {1 person works here, and everybody has worked at least one day.} other {{staff} people work here, and everybody has worked at least one day.}}"
msgstr ""

#. Beside a worker's attendance bar, when they were hired less than a day ago and have already worked.
msgctxt "econ.staff.alreadyWorked"
msgid "Already worked a shift"
msgstr ""

#. Said in the question that asks the owner to confirm the rule for letting inactive workers go, when it would catch nobody today.
msgctxt "econ.staff.commitNobody"
msgid "From now on, anybody who has not worked for {days} days is let go automatically. Nobody here is past {days} days yet, so nothing happens today."
msgstr ""

#. Said in the question that asks the owner to confirm turning the rule for letting inactive workers go off.
msgctxt "econ.staff.commitOff"
msgid "Nobody will be let go automatically from now on. Anybody already gone stays gone."
msgstr ""

#. Said in the question that asks the owner to confirm the rule for letting inactive workers go, when it would catch somebody today.
msgctxt "econ.staff.commitSome"
msgid "From now on, anybody who has not worked for {days} days is let go automatically. {caught, plural, one {1 person here is already past that, so their job ends} other {{caught} people here are already past that, so their jobs end}} on the next check. This cannot be undone."
msgstr ""

#. Why the dismiss button is not offered yet. {left} is a length of time such as "5 hours".
msgctxt "econ.staff.commitment"
msgid "Hiring commits both sides for 24 hours. You can let them go in {left}."
msgstr ""

#. Beside a worker's attendance bar: how many world days they worked out of the days their job has been open to them.
msgctxt "econ.staff.days"
msgid "{shifts} of {opportunities} days"
msgstr ""

#. Said in the question that asks an owner to confirm turning an applicant down, when the owner wrote a reason. {who} is the applicant's username.
msgctxt "econ.staff.declineReason"
msgid "Turns {who} down. Their application closes and your reason is passed on to them word for word; they are free to apply here again, or anywhere else."
msgstr ""

#. Said in the question that asks an owner to confirm turning an applicant down, when the owner wrote no reason. {who} is the applicant's username.
msgctxt "econ.staff.declineSilent"
msgid "Turns {who} down. Their application closes and they are told nothing further; they are free to apply here again, or anywhere else."
msgstr ""

#. Said in the question that asks an owner to confirm letting a worker go. {who} is the worker's username; {site} is a site's name; {wage} is an amount of money.
msgctxt "econ.staff.dismiss"
msgid "Ends {who}'s job at {site} now. They stop earning {wage} a shift and are free to take work anywhere else; to have them back you would have to advertise again and wait for them to apply. This cannot be undone."
msgstr ""

#. About a worker hired less than a day ago who has worked.
msgctxt "econ.staff.hasWorkedShift"
msgid "They have already worked a shift."
msgstr ""

#. Said in the question that asks an owner to confirm hiring an applicant. {who} is the applicant's username; {site} is a site's name; {wage} is an amount of money.
msgctxt "econ.staff.hire"
msgid "Takes {who} on at {site} for {wage} a shift, starting now. Both sides are committed for 24 hours, so you could not let them go before then."
msgstr ""

#. The first part of a line about a worker; the rest follows after a dot. {since} is a length of time such as "3 days".
msgctxt "econ.staff.hiredAgo"
msgid "Hired {since} ago"
msgstr ""

#. The first part of a line about a worker; the rest follows after a dot.
msgctxt "econ.staff.hiredNow"
msgid "Hired just now"
msgstr ""

#. The headline of a company's people page: some of the workers have never worked a shift.
msgctxt "econ.staff.idleHere"
msgid "{idle, plural, one {1 of the {staff, plural, one {1 person} other {{staff} people}} here has not worked a single day since being taken on.} other {{idle} of the {staff, plural, one {1 person} other {{staff} people}} here have not worked a single day since being taken on.}}"
msgstr ""

#. Said beside the owner's rule for letting inactive workers go, when the rule is off.
msgctxt "econ.staff.inactivityOff"
msgid "Nobody is let go automatically. You decide who goes, and when."
msgstr ""

#. Said beside the owner's rule for letting inactive workers go, when the rule is on.
msgctxt "econ.staff.inactivityOn"
msgid "Anybody who has not worked for {days} days is let go automatically, without asking you first. Nobody is dismissed inside their first 24 hours."
msgstr ""

#. Beside a worker's attendance bar, when they were hired less than a day ago.
msgctxt "econ.staff.justTakenOn"
msgid "Just taken on"
msgstr ""

#. The second part of a line about a worker, after "Hired 3 days ago ·". Lower case. {last} is a length of time.
msgctxt "econ.staff.lastWorkedAgo"
msgid "last worked {last} ago"
msgstr ""

#. The second part of a line about a worker, after "Hired 3 days ago ·". Lower case.
msgctxt "econ.staff.lastWorkedNow"
msgid "last worked just now"
msgstr ""

#. The second part of a line about a worker, after "Hired 3 days ago ·". Lower case.
msgctxt "econ.staff.neverWorked"
msgid "has never worked a shift here"
msgstr ""

#. The headline of a company's people page, for an owner.
msgctxt "econ.staff.nobodyNotAdvertising"
msgid "Nobody works here, and you are not advertising for anybody."
msgstr ""

#. The headline of a company's people page, for somebody who does not run the company.
msgctxt "econ.staff.nobodyNothingAdvertised"
msgid "Nobody works here, and nothing is advertised."
msgstr ""

#. A note on a company's people page.
msgctxt "econ.staff.nobodyYet"
msgid "Nobody works here yet."
msgstr ""

#. The headline of a company's people page.
msgctxt "econ.staff.nobodyYetAdvertised"
msgid "Nobody works here yet. {places, plural, one {1 place is advertised.} other {{places} places are advertised.}}"
msgstr ""

#. About a worker who was turned away because the company had no money for their wage. "They" is the worker.
msgctxt "econ.staff.suspended"
msgid "This company could not cover their wage the last time they came to work, so they were turned away. The days missed since are the company's doing rather than theirs. Put money in the treasury and they can work again."
msgstr ""

#. A note on a company's people page: workers were turned away because the company had no money for wages.
msgctxt "econ.staff.suspendedHere"
msgid "{count, plural, one {1 person here could not be paid the last time they came to work.} other {{count} people here could not be paid the last time they came to work.}}"
msgstr ""

#. About a worker. {since} is a length of time such as "3 hours".
msgctxt "econ.staff.takenOn"
msgid "Taken on {since} ago."
msgstr ""

#. About a worker hired a moment ago.
msgctxt "econ.staff.takenOnNow"
msgid "Taken on just now."
msgstr ""

#. Stands in for a site's name where the worker has no site. Lower case, after "at".
msgctxt "econ.staff.thisCompany"
msgid "this company"
msgstr ""

#. About a worker hired less than a day ago.
msgctxt "econ.staff.tooSoon"
msgid "Their first 24 hours are not up, so there is nothing to judge yet, and you could not let them go before then either."
msgstr ""

#. A note on a company's people page. {wages} is an amount of money.
msgctxt "econ.staff.wageBill"
msgid "Wages come to {wages} a shift when everybody works."
msgstr ""

#. The headline of a company's people page: job applicants are waiting for the owner to answer.
msgctxt "econ.staff.waiting"
msgid "{count, plural, one {1 person is waiting for your answer.} other {{count} people are waiting for your answer.}}"
msgstr ""

#. About a worker who has turned up every day. {total} is how many world days their job has been open to them.
msgctxt "econ.staff.workedEvery"
msgid "They have worked every day of the {total} since you took them on."
msgstr ""

#. About a worker who has never turned up. {total} is how many world days their job has been open to them.
msgctxt "econ.staff.workedNone"
msgid "They have not worked a single day of the {total} since you took them on."
msgstr ""

#. About a worker's attendance.
msgctxt "econ.staff.workedSome"
msgid "They have worked {shifts} of the {total} days they could have."
msgstr ""

#. A stake of every share, said where the company is already named.
msgctxt "econ.stake.all"
msgid "all"
msgstr ""

#. A stake of every share in the company.
msgctxt "econ.stake.allOfIt"
msgid "all of it"
msgstr ""

#. A stake of more than half of the company, which lets its holder run it. {percent} is a number such as 62 or 51.5.
msgctxt "econ.stake.controllingOfIt"
msgid "{percent}% of it, a controlling stake"
msgstr ""

#. Added after a figure to say the stake is more than half of the company. Begins with a comma.
msgctxt "econ.stake.controllingTail"
msgid ", a controlling stake"
msgstr ""

#. A share offer that lapses this moment.
msgctxt "econ.stake.expiringNow"
msgid "expiring now"
msgstr ""

#. A stake of exactly half the company. Half is not enough to run it.
msgctxt "econ.stake.halfOfIt"
msgid "exactly half of it"
msgstr ""

#. How long is left to answer a share offer, such as "3 hours left". {left} is a length of time.
msgctxt "econ.stake.left"
msgid "{left} left"
msgstr ""

#. A stake smaller than one in a hundred, said where the company is already named.
msgctxt "econ.stake.lessThanOne"
msgid "less than 1%"
msgstr ""

#. A stake smaller than one in a hundred of the company. Lower case, after a number of shares.
msgctxt "econ.stake.lessThanOneOfIt"
msgid "less than 1% of it"
msgstr ""

#. A row of what somebody owns: the count of shares, then what part of the company that is. For example "20 000 shares · 20% of it".
msgctxt "econ.stake.line"
msgid "{shares} · {portion}"
msgstr ""

#. a stake in a company What part of a company a number of shares is, said under a heading that already names the company. Lower case.
msgctxt "econ.stake.noneOfIt"
msgid "none of it"
msgstr ""

#. A share of a company as a percentage. {percent} is a number such as 20 or 12.5.
msgctxt "econ.stake.percent"
msgid "{percent}%"
msgstr ""

#. A share of a company that is more than half of it, which lets its holder run it. {percent} is such as 62%.
msgctxt "econ.stake.percentControlling"
msgid "{percent}, a controlling stake"
msgstr ""

#. What part of the company a stake is. {percent} is a number such as 20 or 12.5.
msgctxt "econ.stake.percentOfIt"
msgid "{percent}% of it"
msgstr ""

#. A number of shares in a company. A share is one of a hundred thousand equal parts of a company.
msgctxt "econ.stake.shares"
msgid "{count, plural, one {1 share} other {{count} shares}}"
msgstr ""

#. A count of shares and what part of the company they are, such as "250 shares · 20%".
msgctxt "econ.stake.sharesPercent"
msgid "{shares} · {percent}"
msgstr ""

#. One line about a state company whose office has nobody in it. {office} is the title of the office, such as "Minister of Industry". A sentence about who takes care of it follows.
msgctxt "econ.stateOwner.answersTo"
msgid "It answers to the {office}."
msgstr ""

#. One line about a state company that no office runs yet.
msgctxt "econ.stateOwner.caretaker"
msgid "Run by a caretaker until an office takes it."
msgstr ""

#. One line about a state company whose office has nobody in it. {country} is the country's name with its flag; {office} is the title of the office. A sentence about who takes care of it follows.
msgctxt "econ.stateOwner.ownedAnswers"
msgid "Owned by {country}. It answers to the {office}."
msgstr ""

#. One line about a state company that no office runs yet. {country} is the country's name with its flag.
msgctxt "econ.stateOwner.ownedCaretaker"
msgid "Owned by {country}, run by a caretaker until an office takes it."
msgstr ""

#. One line about a state company. {country} is the country's name with its flag; {office} is the title of the office.
msgctxt "econ.stateOwner.ownedRun"
msgid "Owned by {country}, run by its {office}."
msgstr ""

#. One line about a state company. {office} is the title of the office, such as "Minister of Industry".
msgctxt "econ.stateOwner.runBy"
msgid "Run by its {office}."
msgstr ""

#. One line about a state company the reader runs. {country} is the country's name with its flag; {office} is the title of the office the reader holds.
msgctxt "econ.stateOwner.youRun"
msgid "Owned by {country}. You run it while you are its {office}."
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.borrow"
msgid "Borrow money in its name"
msgstr ""

#. One of the things whoever runs a state company may do, in a list.
msgctxt "econ.statePower.build"
msgid "Build and upgrade its sites"
msgstr ""

#. One of the things whoever runs a state company may do, in a list.
msgctxt "econ.statePower.buyShares"
msgid "Buy its shares like any citizen while a sale is open"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list. Closing a company, not shutting a door.
msgctxt "econ.statePower.close"
msgid "Close it down"
msgstr ""

#. One of the things whoever runs a state company may do, in a list.
msgctxt "econ.statePower.delegate"
msgid "Let somebody else do the hiring, until your term ends"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.handOver"
msgid "Hand it to somebody else"
msgstr ""

#. One of the things whoever runs a state company may do, in a list.
msgctxt "econ.statePower.hire"
msgid "Hire people and set their wages"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.pullDown"
msgid "Pull a site down"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.raiseWage"
msgid "Raise your own wage here"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.takeJob"
msgid "Take a job here"
msgstr ""

#. One of the things whoever runs a state company may do, in a list.
msgctxt "econ.statePower.trade"
msgid "Buy and sell for it on the market"
msgstr ""

#. One of the things whoever runs a state company may not do, in a list.
msgctxt "econ.statePower.tradeOwn"
msgid "Trade goods with it on your own account"
msgstr ""

#. Shown while the reader types how much money to put into a company being founded: what they would own, when it is more than half. {share} is such as "about 62%".
msgctxt "econ.venture.wouldOwnControl"
msgid "You would own {share}, a controlling stake"
msgstr ""

#. Where a wage comparison comes from: how many jobs, in the reader's country. In brackets.
msgctxt "econ.wage.basisCountry"
msgid "({count, plural, one {1 job} other {{count} jobs}} in this country)"
msgstr ""

#. Where a wage comparison comes from: how many jobs, in which province. In brackets.
msgctxt "econ.wage.basisProvince"
msgid "({count, plural, one {1 job} other {{count} jobs}} in {province})"
msgstr ""

#. Where a wage comparison comes from: how many jobs, anywhere in the world. In brackets.
msgctxt "econ.wage.basisWorld"
msgid "({count, plural, one {1 job} other {{count} jobs}} worldwide)"
msgstr ""

#. Said beside a wage the reader sets. {amount} is an amount of money; {basis} is in brackets: how many jobs, and where.
msgctxt "econ.wage.less"
msgid "Pays {amount} less than the average for this work {basis}."
msgstr ""

#. Said beside a wage the reader sets. {amount} is an amount of money; {basis} is in brackets: how many jobs, and where.
msgctxt "econ.wage.more"
msgid "Pays {amount} more than the average for this work {basis}."
msgstr ""

#. Said beside a wage the reader sets for a job, when no job like it has been paid anywhere.
msgctxt "econ.wage.nobody"
msgid "Nobody anywhere has been paid for this work yet, so there is nothing to compare this with."
msgstr ""

#. Said beside a wage the reader sets. {wage} is an amount of money.
msgctxt "econ.wage.onlyOne"
msgid "Only one job anywhere in the world pays for this work, at {wage}, which is a single wage rather than a going rate."
msgstr ""

#. Said beside a wage the reader sets for a job. {basis} is in brackets: how many jobs, and where.
msgctxt "econ.wage.same"
msgid "Pays the same as the average for this work {basis}."
msgstr ""

#. A wait in whole hours, rounded up.
msgctxt "econ.wait.hours"
msgid "{count, plural, one {1 hour} other {{count} hours}}"
msgstr ""

#. Said after "Ready" when a site is about to open.
msgctxt "econ.workers.anyMoment"
msgid "any moment now"
msgstr ""

#. The button that confirms offering a worker a move. {name} is a username.
msgctxt "econ.workers.askAct"
msgid "Ask {name} to move"
msgstr ""

#. The button that starts offering a worker a move.
msgctxt "econ.workers.askButton"
msgid "Ask them to move"
msgstr ""

#. Said in the question that asks an owner to confirm offering a worker a move.
msgctxt "econ.workers.askConsequence"
msgid "Nothing changes unless they accept: they keep working where they are, at the wage they are on, until they answer."
msgstr ""

#. Said after a move was offered to a worker. {name} is a username.
msgctxt "econ.workers.askDone"
msgid "The offer is with {name}."
msgstr ""

#. The question that asks an owner to confirm offering a worker a move. {name} is a username.
msgctxt "econ.workers.askQuestion"
msgid "Ask {name} to move?"
msgstr ""

#. Says who is told once an owner offers a move. {name} is a username.
msgctxt "econ.workers.askTold"
msgid "{name} is asked."
msgstr ""

#. Why an owner cannot offer a worker a move: every other site is under construction. {count} is how many other sites there are; {place} is the name of the only one; {name} is a username.
msgctxt "econ.workers.building"
msgid "{count, plural, one {{place} is still being built, so there is nowhere finished to move {name} to yet.} other {The company's other places are still being built, so there is nowhere finished to move {name} to yet.}}"
msgstr ""

#. The button in the question that confirms proposing a lower wage.
msgctxt "econ.workers.cutAct"
msgid "Put the cut to them"
msgstr ""

#. The button that starts proposing a lower wage.
msgctxt "econ.workers.cutButton"
msgid "Put the cut to them"
msgstr ""

#. Said in the question that asks an owner to confirm proposing a lower wage. {was} and {now} are wages with CR; {name} is a username.
msgctxt "econ.workers.cutConsequence"
msgid "Puts a cut from {was} to {now} to {name}. They keep {was} a shift until they answer, and may leave at once instead."
msgstr ""

#. Said after a lower wage was proposed. {now} is the proposed wage with CR; {name} is a username.
msgctxt "econ.workers.cutDone"
msgid "The cut to {now} is with {name}."
msgstr ""

#. Said under the wage field when the new wage is lower than the old one. "They" is the worker; "the commitment" is the 24 hours both sides are tied after hiring.
msgctxt "econ.workers.cutNote"
msgid "A cut is put to them rather than made: they keep the wage they have until they accept, and while it waits they may leave at once rather than sit out the 24 hours. You cannot: letting somebody go still waits for the commitment to lift."
msgstr ""

#. The question that asks an owner to confirm proposing a lower wage. {now} is the new wage with CR, such as "12.00 CR"; {name} is a username.
msgctxt "econ.workers.cutQuestion"
msgid "Put a cut to {now} to {name}?"
msgstr ""

#. Said on a company's people page when nobody works there yet.
msgctxt "econ.workers.empty"
msgid "A company needs somewhere to work before it can employ anybody, and then somebody has to apply, or be taken on automatically, before anyone appears here."
msgstr ""

#. The button that confirms ending a worker's job. {name} is a username.
msgctxt "econ.workers.letGoAct"
msgid "Let {name} go"
msgstr ""

#. The button that starts ending a worker's job. {who} is the worker's name.
msgctxt "econ.workers.letGoButton"
msgid "Let {who} go"
msgstr ""

#. Said after a worker's job ended. {name} is a username.
msgctxt "econ.workers.letGoDone"
msgid "{name} no longer works here."
msgstr ""

#. The question that asks an owner to confirm ending a worker's job. {name} is a username; {company} is the company's name.
msgctxt "econ.workers.letGoQuestion"
msgid "Let {name} go from {company}?"
msgstr ""

#. The title of a fold that holds what an owner may do about one worker. A verb.
msgctxt "econ.workers.manage"
msgid "Manage"
msgstr ""

#. The accessible name of the fold that holds what an owner may do about one worker. {name} is a username.
msgctxt "econ.workers.manageWho"
msgid "Manage {name}"
msgstr ""

#. The short label of a bar that shows how many days a worker has worked. Keep it to one short word.
msgctxt "econ.workers.meterLabel"
msgid "Worked"
msgstr ""

#. Said under the optional wage field. {wage} is an amount of money, the worker's current wage.
msgctxt "econ.workers.moveHint"
msgid "Leave it empty and they keep {wage} a shift."
msgstr ""

#. The first, empty choice of the list of sites to offer a worker.
msgctxt "econ.workers.movePick"
msgid "Choose a place"
msgstr ""

#. The title of a fold that holds a form for offering a worker a move to another site. {who} is the worker's name.
msgctxt "econ.workers.moveTitle"
msgid "Move {who} to another place"
msgstr ""

#. The label of the optional field where the owner types a wage to offer with the move.
msgctxt "econ.workers.moveWage"
msgid "A different wage, if you want one"
msgstr ""

#. The label of the list where the owner picks the site to offer a worker.
msgctxt "econ.workers.moveWhere"
msgid "Where"
msgstr ""

#. Stands in for a site's name in a worker's line when they have no site.
msgctxt "econ.workers.noPlace"
msgid "no place"
msgstr ""

#. Said under the search box on a company's people list when nothing matches.
msgctxt "econ.workers.nobodyNamed"
msgid "Nobody by that name works here."
msgstr ""

#. The tooltip of a mark beside a worker's name: they have not worked a shift on the current world day. {name} is a username.
msgctxt "econ.workers.notWorkedToday"
msgid "{name} has not worked today"
msgstr ""

#. The button in the question that confirms raising a wage. {now} is the new wage with CR.
msgctxt "econ.workers.payAct"
msgid "Pay {now} a shift"
msgstr ""

#. The button that starts raising a wage.
msgctxt "econ.workers.payButton"
msgid "Pay them this"
msgstr ""

#. Said in the question that asks an owner to confirm raising a wage. {now} is the new wage with CR; {name} is a username.
msgctxt "econ.workers.payConsequence"
msgid "Pays {name} {now} a shift from their next shift on, out of the company's treasury."
msgstr ""

#. Said after a wage was raised. {now} is the new wage with CR; {name} is a username.
msgctxt "econ.workers.payDone"
msgid "{name} is paid {now} a shift from the next shift."
msgstr ""

#. The question that asks an owner to confirm raising a wage. {now} is the new wage with CR, such as "12.00 CR"; {name} is a username.
msgctxt "econ.workers.payQuestion"
msgid "Pay {name} {now} a shift?"
msgstr ""

#. A choice in a list of sites: the site's name, then the province it is in.
msgctxt "econ.workers.placeOption"
msgid "{name} · {province}"
msgstr ""

#. Said under the wage field when the new wage is higher than the old one.
msgctxt "econ.workers.raiseNote"
msgid "A raise takes effect from their next shift."
msgstr ""

#. Said after the reason a move cannot be offered yet: when the first new place opens. {when} is a length of time such as "in 3h" or the phrase "any moment now".
msgctxt "econ.workers.ready"
msgid "Ready {when}."
msgstr ""

#. Said in place of the wage button when the typed wage is too low. {least} is an amount of money, the smallest wage.
msgctxt "econ.workers.wageFloor"
msgid "A wage has to be at least {least} a shift. Type what you want to pay and the control comes back."
msgstr ""

#. The label of the field where the owner types a wage. A short shift is the shorter of the two shifts a worker may work. CR is the game's money.
msgctxt "econ.workers.wageLabel"
msgid "What it pays a short shift (CR)"
msgstr ""

#. A line under a worker's name: where they work and what a shift pays. {wage} is an amount of money.
msgctxt "econ.workers.wageLine"
msgid "{place} · {wage} a shift"
msgstr ""

#. A line under a worker's name: where they work and what a shift pays, and that the owner has proposed a lower wage which the worker has not answered yet. {wage} and {cut} are amounts of money.
msgctxt "econ.workers.wageLineCut"
msgid "{place} · {wage} a shift · a cut to {cut} is with them, and the old wage stands until they answer"
msgstr ""

#. The title of a fold that holds a form for changing a worker's wage. {who} is the worker's name.
msgctxt "econ.workers.wageTitle"
msgid "Change what {who} is paid"
msgstr ""

#. The tooltip of a mark beside a worker's name: they worked a shift on the current world day. {name} is a username.
msgctxt "econ.workers.workedToday"
msgid "{name} worked today"
msgstr ""

#. Said when public works cannot be raised or repaired right now. {what} is the province and the kind of works.
msgctxt "econ.works.blocked"
msgid "{what} cannot be worked on now."
msgstr ""

#. Said when public works cannot be raised any further. {what} is the province and the kind of works.
msgctxt "econ.works.maxed"
msgid "{what} is already at level 10."
msgstr ""

#. Where a list of goods would be, when the works need none.
msgctxt "econ.works.noMaterials"
msgid "no materials"
msgstr ""

#. The price of repairing public works. {what} is the province and the kind of works; {from} is how damaged they are now; {shifts} is how many days of work citizens must give; {materials} is a list of goods or "no materials".
msgctxt "econ.works.repair"
msgid "{what}: repair from {from}% to 100%. {shifts, plural, one {1 shift} other {{shifts} shifts}} and {materials}."
msgstr ""

#. Said when public works need no repair. {what} is the province and the kind of works.
msgctxt "econ.works.undamaged"
msgid "{what} is not damaged."
msgstr ""

#. The price of raising public works one level. {what} is the province and the kind of works; {shifts} is how many days of work citizens must give; {materials} is a list of goods such as "40 construction materials and 5 industrial components", or "no materials".
msgctxt "econ.works.upgrade"
msgid "{what}: level {from} to {to}. {shifts, plural, one {1 shift} other {{shifts} shifts}} and {materials}."
msgstr ""

#. The name of one kind of public works in a province: its name, then the kind in lower case, such as "Zagreb roads and rail".
msgctxt "econ.works.what"
msgid "{province} {kind}"
msgstr ""

