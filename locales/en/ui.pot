msgctxt "power.selection.appointment.label"
msgid "Appointed"
msgstr ""

msgctxt "power.selection.appointment.means"
msgid "Somebody who already holds authority puts a person here, and they hold it at that person's pleasure, until the government that appointed them ends."
msgstr ""

#. How an office is filled; a short label on a chip.
msgctxt "power.selection.directElection.label"
msgid "Elected by the country"
msgstr ""

msgctxt "power.selection.directElection.means"
msgid "Every citizen old enough to vote here chooses who holds it, on a fixed schedule nobody can bring forward except by law."
msgstr ""

msgctxt "power.selection.fallback.means"
msgid "How this office is filled."
msgstr ""

#. How an office is filled; a short label on a chip.
msgctxt "power.selection.indirectElection.label"
msgid "Chosen by the chamber"
msgstr ""

msgctxt "power.selection.indirectElection.means"
msgid "The elected chamber picks whoever holds it, and can replace them without going back to the country."
msgstr ""

#. How an office is filled; a short label on a chip.
msgctxt "power.selection.namedSuccession.label"
msgid "Held for life, successor named"
msgstr ""

msgctxt "power.selection.namedSuccession.means"
msgid "It never faces an election. Whoever holds it names a living citizen to follow them, and there is nothing to inherit: Gray Horizon has no families."
msgstr ""

